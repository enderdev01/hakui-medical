---
import Aranceles from '@components/secciones/Aranceles.astro';
import Asistente from '@components/secciones/Asistente.astro';
import Cinta from '@components/secciones/Cinta.astro';
import Especialidades from '@components/secciones/Especialidades.astro';
import Hero from '@components/secciones/Hero.astro';
import Preguntas from '@components/secciones/Preguntas.astro';
import Proceso from '@components/secciones/Proceso.astro';
import Testimonios from '@components/secciones/Testimonios.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { clinica } from '@data/index';
---

<BaseLayout
  titulo={`${clinica.nombre} — describe lo que sientes y te decimos a qué consulta ir`}
  descripcion="Clínica ambulatoria con seis especialidades, laboratorio propio y un asistente que traduce tus síntomas en una cita concreta."
>
  <Hero />
  <Cinta />
  <Asistente />
  <Especialidades />
  <Aranceles />
  <Proceso />
  <Testimonios />
  <Preguntas />
</BaseLayout>
