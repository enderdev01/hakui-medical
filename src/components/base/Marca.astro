---
import { clinica } from '@data/index';

interface Props {
  /** En el hero la marca va sobre fondo oscuro. */
  tono?: 'claro' | 'oscuro';
  tamano?: number;
  /** Marca la unidad como encabezado principal cuando corresponde. */
  comoEnlace?: boolean;
}

const { tono = 'oscuro', tamano = 36, comoEnlace = true } = Astro.props;
const Etiqueta = comoEnlace ? 'a' : 'span';
---

<Etiqueta class:list={['marca', `marca--${tono}`]} href={comoEnlace ? '#inicio' : undefined}>
  <svg
    class="marca__signo"
    width={tamano}
    height={tamano}
    viewBox="0 0 38 38"
    fill="none"
    aria-hidden="true"
  >
    <rect x="1" y="1" width="36" height="36" rx="12" fill="var(--c-acento)"></rect>
    <path
      d="M13 11v16M25 11v16M13 19h12"
      stroke="var(--c-fondo)"
      stroke-width="3.4"
      stroke-linecap="round"
    ></path>
  </svg>
  <span class="marca__texto">
    {clinica.marca.fuerte} <span class="marca__suave">{clinica.marca.suave}</span>
  </span>
</Etiqueta>

<style lang="scss">
  .marca {
    @include foco;

    display: inline-flex;
    gap: var(--e-3);
    align-items: center;
    min-block-size: var(--toque-min);
    font-family: var(--f-titulo);
    font-size: var(--t-marca);
    font-weight: var(--p-fuerte);
    letter-spacing: -0.02em;
    text-decoration: none;

    // Cada variante conserva su color al pasar el mouse. `color: inherit` en el
    // hover tomaba el color del body —tinta oscura— y sobre la cabecera oscura
    // el logotipo se hundía en el fondo.
    &--oscuro,
    &--oscuro:hover {
      color: var(--c-tinta);

      .marca__suave {
        color: var(--c-texto-tenue);
      }
    }

    &--claro,
    &--claro:hover {
      color: var(--c-texto-inverso);

      .marca__suave {
        color: var(--c-texto-inverso-marca);
      }
    }

    &--claro:focus-visible {
      outline-color: var(--c-fondo);
    }

    // La única señal de que es interactivo: el signo se agranda un poco.
    // El color no se toca.
    .marca__signo {
      transition: transform var(--m-rapido) var(--m-curva);
    }

    &:hover .marca__signo {
      transform: scale(1.06);
    }
  }

  .marca__signo {
    flex-shrink: 0;
  }

  .marca__suave {
    font-weight: var(--p-semi);
  }
</style>
