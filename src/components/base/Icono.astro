---
// Iconografía del sitio: trazo de 1.7 sobre grilla de 24.
//
// Van en línea y heredan `currentColor` para que un icono dentro de un botón
// tome el color del botón sin declarar nada. Nunca se usan emoji: no escalan,
// no se recolorean y cambian de forma según el sistema operativo.
import type { Icono as NombreIcono } from '@data/tipos';

interface Props {
  nombre: NombreIcono;
  tamano?: number;
  /** Texto alternativo. Sin él, el icono se marca como decorativo. */
  titulo?: string;
  class?: string;
}

const { nombre, tamano = 24, titulo, class: clase } = Astro.props;

// Cada entrada es el contenido del `<svg>`. Se mantienen como cadenas para que
// añadir un icono sea una línea y no un archivo nuevo.
const trazos: Record<NombreIcono, string> = {
  estetoscopio: `<path d="M7 3v6a4 4 0 0 0 8 0V3" /><path d="M11 13v2a4 4 0 0 0 8 0v-2" /><circle cx="19" cy="10" r="2.4" />`,
  oido: `<path d="M7 9.5a5 5 0 0 1 10 0c0 3.2-3.1 4-3.1 6.6A3.4 3.4 0 0 1 10.5 19.5" /><path d="M10.2 9.8a1.9 1.9 0 0 1 3.8 0c0 1.6-1.7 2-1.7 3.4" />`,
  bebe: `<circle cx="12" cy="10" r="6.2" /><path d="M9.8 12.4a3 3 0 0 0 4.4 0" /><path d="M6 19.5h12" /><circle cx="9.8" cy="9.4" r="0.9" fill="currentColor" stroke="none" /><circle cx="14.2" cy="9.4" r="0.9" fill="currentColor" stroke="none" />`,
  lazo: `<path d="M12 11.6c-2.1-2-3.2-3.3-3.2-5A3.2 3.2 0 0 1 12 3.4a3.2 3.2 0 0 1 3.2 3.2c0 1.7-1.1 3-3.2 5z" /><path d="M10.4 11.2 14.6 20.6M13.6 11.2 9.4 20.6" />`,
  estomago: `<path d="M9.4 3.5v3.8c0 2.5 6.2 1.3 6.2 5.5 0 3.4-2.5 5.9-5.5 5.9-2.5 0-4.4-1.5-4.9-3.4" /><path d="M7.4 3.5h4M12 18.7v1.8" />`,
  matraz: `<path d="M9.5 3v6.4L4.8 18a2 2 0 0 0 1.7 3h11a2 2 0 0 0 1.7-3l-4.7-8.6V3" /><path d="M8 3h8M7.4 15h9.2" />`,
  calendario: `<rect x="3" y="5" width="18" height="16" rx="4" /><path d="M3 10h18M8 3v4M16 3v4" />`,
  chispa: `<path d="M12 3.5l1.9 4.9 4.9 1.9-4.9 1.9L12 17.1l-1.9-4.9L5.2 10.3l4.9-1.9z" fill="currentColor" stroke="none" /><path d="M18.5 15.5l.8 2.1 2.1.8-2.1.8-.8 2.1-.8-2.1-2.1-.8 2.1-.8z" fill="currentColor" stroke="none" />`,
  instagram: `<rect x="3" y="3" width="18" height="18" rx="5.5" /><circle cx="12" cy="12" r="4" /><circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none" />`,
  alerta: `<path d="M12 3.5 21 19H3z" /><path d="M12 10v3.4M12 16.4v.2" />`,
  telefono: `<path d="M6.5 4h3l1.5 4-2 1.4a12 12 0 0 0 5.6 5.6l1.4-2 4 1.5v3a1.6 1.6 0 0 1-1.8 1.6C11.3 18.4 5.6 12.7 4.9 5.8A1.6 1.6 0 0 1 6.5 4z" />`,
  whatsapp: `<path d="M4 20l1.2-4A8 8 0 1 1 8 18.8z" />`,
  flecha: `<path d="M9 6l6 6-6 6" />`,
  menu: `<path d="M4 7h16M4 12h16M4 17h16" />`,
  cerrar: `<path d="M6 6l12 12M18 6L6 18" />`,
  pregunta: `<circle cx="12" cy="12" r="8.6" /><path d="M9.8 9.6a2.3 2.3 0 0 1 4.4.8c0 1.6-2.2 1.8-2.2 3.2M12 17v.2" />`,
  documento: `<path d="M6 4h12v16l-3-2-3 2-3-2-3 2z" /><path d="M9.5 9h5M9.5 13h5" />`,
};
---

<svg
  class:list={['icono', clase]}
  width={tamano}
  height={tamano}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={titulo ? 'img' : undefined}
  aria-hidden={titulo ? undefined : 'true'}
  aria-label={titulo}
  set:html={trazos[nombre]}
/>

<style lang="scss">
  .icono {
    flex-shrink: 0;
  }
</style>
