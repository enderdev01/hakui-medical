---
import EncabezadoSeccion from '@components/base/EncabezadoSeccion.astro';
import Icono from '@components/base/Icono.astro';
import Seccion from '@components/base/Seccion.astro';
import { especialidades } from '@data/index';
import { precio } from '@lib/formato';

// Las seis salen del módulo de datos. Cambiar una especialidad o su precio no
// pasa por acá.
---

<Seccion id="especialidades">
  <div class="especialidades__cabecera">
    <EncabezadoSeccion
      eyebrow="Especialidades"
      titulo="Seis áreas, una sola sede"
      entrada="Somos una clínica pequeña a propósito: lo que atendemos, lo atendemos completo."
    />
    <a class="especialidades__atajo" href="#aranceles">
      Ver aranceles de cada una
    </a>
  </div>

  <ul class="especialidades__rejilla">
    {especialidades.map((especialidad) => (
      <li class="tarjeta">
        <span class="tarjeta__icono">
          <Icono nombre={especialidad.icono} tamano={26} />
        </span>
        <h3 class="tarjeta__titulo">{especialidad.nombre}</h3>
        <p class="tarjeta__descripcion">{especialidad.descripcion}</p>
        <p class="tarjeta__precio">Desde {precio(especialidad.desde)}</p>
      </li>
    ))}
  </ul>
</Seccion>

<style lang="scss">
  .especialidades__cabecera {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-6);
    align-items: flex-end;
    justify-content: space-between;
    padding-block-end: var(--e-8);
  }

  .especialidades__atajo {
    @include foco;

    font-size: var(--t-sm);
    font-weight: var(--p-medio);
  }

  .especialidades__rejilla {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--e-4);

    @include desde('sm') {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    @include desde('lg') {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  // Las tarjetas se estiran a la altura de la fila y el precio queda abajo,
  // aunque las descripciones tengan distinto largo.
  .tarjeta {
    display: flex;
    flex-direction: column;
    gap: var(--e-3);
    height: 100%;
    padding: var(--e-6);
    background: var(--c-fondo-alt);
    border: 1px solid var(--c-borde);
    border-radius: var(--r-lg);
    transition:
      border-color var(--m-medio) ease,
      transform var(--m-medio) ease;

    &:hover {
      border-color: var(--c-acento-borde);
      transform: translateY(-3px);
    }
  }

  .tarjeta__icono {
    display: grid;
    place-items: center;
    inline-size: 48px;
    block-size: 48px;
    color: var(--c-acento-fuerte);
    background: var(--c-fondo);
    border: 1px solid var(--c-acento-borde);
    border-radius: var(--r-sm);
  }

  .tarjeta__titulo {
    font-size: var(--t-h4);
  }

  .tarjeta__descripcion {
    // Empuja el precio al pie de la tarjeta.
    flex-grow: 1;
    font-size: var(--t-sm);
    line-height: var(--i-base);
    color: var(--c-texto-tenue);
  }

  .tarjeta__precio {
    font-size: var(--t-sm);
    font-weight: var(--p-medio);
    color: var(--c-acento-fuerte);
    font-variant-numeric: tabular-nums;
  }

  @include movimiento-reducido {
    .tarjeta:hover {
      transform: none;
    }
  }
</style>
