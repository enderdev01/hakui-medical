---
import EncabezadoSeccion from '@components/base/EncabezadoSeccion.astro';
import Seccion from '@components/base/Seccion.astro';
import { testimonios } from '@data/index';

// Testimonios simulados. Antes de publicar para un cliente real hay que
// reemplazarlos o retirarlos: presentarlos como reales sin autorización del
// paciente es un problema, no un detalle.
---

<Seccion fondo="neutro">
  <EncabezadoSeccion eyebrow="Pacientes" titulo="Lo que dicen quienes ya vinieron" />

  <ul class="testimonios">
    {testimonios.map((testimonio) => (
      <li class="testimonio">
        <svg class="testimonio__comillas" viewBox="0 0 34 26" fill="none" aria-hidden="true">
          <path
            d="M0 26V13C0 5.8 4.8 1 12 0v5.2C8.4 6.2 6.6 8.6 6.6 12.4H12V26zM22 26V13C22 5.8 26.8 1 34 0v5.2c-3.6 1-5.4 3.4-5.4 7.2H34V26z"
            fill="var(--c-acento-borde)"
          />
        </svg>
        <blockquote class="testimonio__cita">
          <p>{testimonio.cita}</p>
        </blockquote>
        <footer class="testimonio__pie">
          <cite class="testimonio__paciente">{testimonio.paciente}</cite>
          <span class="testimonio__especialidad">{testimonio.especialidad}</span>
        </footer>
      </li>
    ))}
  </ul>
</Seccion>

<style lang="scss">
  .testimonios {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--e-4);
    padding-block-start: var(--e-8);

    @include desde('lg') {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .testimonio {
    display: flex;
    flex-direction: column;
    gap: var(--e-4);
    height: 100%;
    padding: var(--e-6);
    background: var(--c-fondo);
    border: 1px solid var(--c-borde);
    border-radius: var(--r-lg);
  }

  .testimonio__comillas {
    inline-size: 30px;
    block-size: 23px;
  }

  .testimonio__cita {
    // Empuja el pie de la tarjeta hacia abajo para que los nombres queden
    // alineados aunque las citas tengan distinto largo.
    flex-grow: 1;
    margin: 0;
    font-size: var(--t-base);
    line-height: 1.65;
    color: var(--c-texto);
  }

  .testimonio__pie {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .testimonio__paciente {
    font-size: var(--t-sm);
    font-weight: var(--p-medio);
    font-style: normal;
    color: var(--c-tinta);
  }

  .testimonio__especialidad {
    font-size: var(--t-xs);
    color: var(--c-texto-tenue);
  }
</style>
